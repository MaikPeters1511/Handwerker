<Project Sdk="Aspire.AppHost.Sdk/13.4.6">
    
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <UserSecretsId>33c699dd-af8f-48cb-a38c-4278b7de95ee</UserSecretsId>
    </PropertyGroup>
    
    <ItemGroup>
      <Compile Remove="seq-data\**" />
      <EmbeddedResource Remove="seq-data\**" />
      <None Remove="seq-data\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Handwerker.ApiService\Handwerker.ApiService.csproj" />
        <ProjectReference Include="..\Handwerker.Web\Handwerker.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.DevTunnels" Version="13.4.6" />
        <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
        <PackageReference Include="Aspire.Hosting.Keycloak" Version="13.4.6-preview.1.26319.6" />
        <PackageReference Include="Aspire.Hosting.Maui" Version="13.4.6-preview.1.26319.6" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
        <PackageReference Include="Aspire.Hosting.Redis" Version="13.4.6" />
        <PackageReference Include="Aspire.Hosting.Seq" Version="13.4.6" />
        <PackageReference Include="CommunityToolkit.Aspire.Hosting.Adminer" Version="13.4.1-beta.687" />
        <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.4.1-beta.687" />
    </ItemGroup>

    <Target Name="RestoreNpm" BeforeTargets="Build" Condition=" '$(DesignTimeBuild)' != 'true' ">
        <ItemGroup>
            <PackageJsons Include="..\*\package.json" />
        </ItemGroup>

        <!-- Install npm packages if node_modules is missing -->
        <Message Importance="Normal" Text="Installing npm packages for %(PackageJsons.RelativeDir)" Condition="!Exists('%(PackageJsons.RootDir)%(PackageJsons.Directory)/node_modules')" />
        <Exec Command="pnpm install" WorkingDirectory="%(PackageJsons.RootDir)%(PackageJsons.Directory)" Condition="!Exists('%(PackageJsons.RootDir)%(PackageJsons.Directory)/node_modules')" />
    </Target>
</Project>
